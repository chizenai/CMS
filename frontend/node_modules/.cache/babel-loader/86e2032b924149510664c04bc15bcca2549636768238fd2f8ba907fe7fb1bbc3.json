{"ast":null,"code":"import { getMenuTree, createMenu, updateMenu, deleteMenu } from '@/api/menu';\nexport default {\n  name: 'MenuList',\n  data() {\n    return {\n      menuList: [],\n      menuTreeData: [],\n      dialogVisible: false,\n      dialogTitle: '新增菜单',\n      menuForm: {\n        id: null,\n        parentId: 0,\n        menuName: '',\n        menuCode: '',\n        path: '',\n        component: '',\n        icon: '',\n        menuType: 2,\n        sort: 0,\n        permission: '',\n        status: 1\n      },\n      menuRules: {\n        menuName: [{\n          required: true,\n          message: '请输入菜单名称',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  created() {\n    this.loadData();\n  },\n  methods: {\n    async loadData() {\n      try {\n        const res = await getMenuTree();\n        this.menuList = res.data;\n        this.menuTreeData = [{\n          id: 0,\n          menuName: '根目录',\n          children: res.data\n        }];\n      } catch (error) {\n        console.error('加载数据失败:', error);\n        this.$message.error('加载数据失败');\n      }\n    },\n    handleAdd(parentId) {\n      this.dialogTitle = parentId === 0 ? '新增菜单' : '添加子菜单';\n      this.menuForm = {\n        id: null,\n        parentId: parentId,\n        menuName: '',\n        menuCode: '',\n        path: '',\n        component: '',\n        icon: '',\n        menuType: parentId === 0 ? 1 : 2,\n        sort: 0,\n        permission: '',\n        status: 1\n      };\n      this.dialogVisible = true;\n    },\n    handleEdit(row) {\n      this.dialogTitle = '编辑菜单';\n      this.menuForm = {\n        ...row\n      };\n      this.dialogVisible = true;\n    },\n    async handleDelete(row) {\n      try {\n        await this.$confirm('确定要删除这个菜单吗？', '提示', {\n          type: 'warning'\n        });\n        await deleteMenu(row.id);\n        this.$message.success('删除成功');\n        this.loadData();\n      } catch (error) {\n        if (error !== 'cancel') {\n          console.error('删除失败:', error);\n          this.$message.error('删除失败');\n        }\n      }\n    },\n    async handleSubmit() {\n      this.$refs.menuFormRef.validate(async valid => {\n        if (valid) {\n          try {\n            if (this.menuForm.id) {\n              await updateMenu(this.menuForm);\n              this.$message.success('更新成功');\n            } else {\n              await createMenu(this.menuForm);\n              this.$message.success('创建成功');\n            }\n            this.dialogVisible = false;\n            this.loadData();\n          } catch (error) {\n            console.error('提交失败:', error);\n            this.$message.error('提交失败');\n          }\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["getMenuTree","createMenu","updateMenu","deleteMenu","name","data","menuList","menuTreeData","dialogVisible","dialogTitle","menuForm","id","parentId","menuName","menuCode","path","component","icon","menuType","sort","permission","status","menuRules","required","message","trigger","created","loadData","methods","res","children","error","console","$message","handleAdd","handleEdit","row","handleDelete","$confirm","type","success","handleSubmit","$refs","menuFormRef","validate","valid"],"sources":["src/views/system/MenuList.vue"],"sourcesContent":["<template>\n  <div class=\"menu-list-container\">\n    <div class=\"card-box\">\n      <div class=\"header-row\">\n        <h3>菜单管理</h3>\n        <el-button type=\"primary\" @click=\"handleAdd(0)\">\n          <i class=\"el-icon-plus\"></i> 新增菜单\n        </el-button>\n      </div>\n      <el-table :data=\"menuList\" border row-key=\"id\" default-expand-all>\n        <el-table-column prop=\"menuName\" label=\"菜单名称\" min-width=\"200\"></el-table-column>\n        <el-table-column prop=\"menuCode\" label=\"菜单编码\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"path\" label=\"路由路径\" width=\"150\"></el-table-column>\n        <el-table-column prop=\"component\" label=\"组件路径\" width=\"180\"></el-table-column>\n        <el-table-column prop=\"icon\" label=\"图标\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <i :class=\"scope.row.icon\" v-if=\"scope.row.icon\"></i>\n            <span v-else>-</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"menuType\" label=\"类型\" width=\"80\">\n          <template slot-scope=\"scope\">\n            <el-tag v-if=\"scope.row.menuType === 1\" type=\"info\">目录</el-tag>\n            <el-tag v-else-if=\"scope.row.menuType === 2\" type=\"primary\">菜单</el-tag>\n            <el-tag v-else-if=\"scope.row.menuType === 3\" type=\"success\">按钮</el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"sort\" label=\"排序\" width=\"80\"></el-table-column>\n        <el-table-column prop=\"permission\" label=\"权限标识\" width=\"150\"></el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"80\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.status === 1 ? 'success' : 'danger'\">\n              {{ scope.row.status === 1 ? '启用' : '禁用' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"handleAdd(scope.row.id)\">添加子菜单</el-button>\n            <el-button type=\"text\" @click=\"handleEdit(scope.row)\">编辑</el-button>\n            <el-button type=\"text\" style=\"color: #f56c6c\" @click=\"handleDelete(scope.row)\">删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </div>\n\n    <el-dialog :title=\"dialogTitle\" :visible.sync=\"dialogVisible\" width=\"600px\">\n      <el-form :model=\"menuForm\" :rules=\"menuRules\" ref=\"menuFormRef\" label-width=\"100px\">\n        <el-form-item label=\"上级菜单\" prop=\"parentId\">\n          <el-tree-select\n            v-model=\"menuForm.parentId\"\n            :data=\"menuTreeData\"\n            :props=\"{ label: 'menuName', value: 'id', children: 'children' }\"\n            placeholder=\"请选择上级菜单\"\n            :default-expand-all=\"true\"\n            :check-strictly=\"true\"\n            clearable\n          ></el-tree-select>\n        </el-form-item>\n        <el-form-item label=\"菜单名称\" prop=\"menuName\">\n          <el-input v-model=\"menuForm.menuName\" placeholder=\"请输入菜单名称\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"菜单编码\" prop=\"menuCode\">\n          <el-input v-model=\"menuForm.menuCode\" placeholder=\"请输入菜单编码\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"路由路径\" prop=\"path\" v-if=\"menuForm.menuType !== 3\">\n          <el-input v-model=\"menuForm.path\" placeholder=\"请输入路由路径\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"组件路径\" prop=\"component\" v-if=\"menuForm.menuType === 2\">\n          <el-input v-model=\"menuForm.component\" placeholder=\"请输入组件路径\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"图标\" prop=\"icon\" v-if=\"menuForm.menuType !== 3\">\n          <el-input v-model=\"menuForm.icon\" placeholder=\"请输入图标类名\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"菜单类型\" prop=\"menuType\">\n          <el-radio-group v-model=\"menuForm.menuType\">\n            <el-radio :label=\"1\">目录</el-radio>\n            <el-radio :label=\"2\">菜单</el-radio>\n            <el-radio :label=\"3\">按钮</el-radio>\n          </el-radio-group>\n        </el-form-item>\n        <el-form-item label=\"排序\" prop=\"sort\">\n          <el-input-number v-model=\"menuForm.sort\" :min=\"0\"></el-input-number>\n        </el-form-item>\n        <el-form-item label=\"权限标识\" prop=\"permission\">\n          <el-input v-model=\"menuForm.permission\" placeholder=\"请输入权限标识\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"状态\" prop=\"status\">\n          <el-radio-group v-model=\"menuForm.status\">\n            <el-radio :label=\"1\">启用</el-radio>\n            <el-radio :label=\"0\">禁用</el-radio>\n          </el-radio-group>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"handleSubmit\">确定</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { getMenuTree, createMenu, updateMenu, deleteMenu } from '@/api/menu'\n\nexport default {\n  name: 'MenuList',\n  data() {\n    return {\n      menuList: [],\n      menuTreeData: [],\n      dialogVisible: false,\n      dialogTitle: '新增菜单',\n      menuForm: {\n        id: null,\n        parentId: 0,\n        menuName: '',\n        menuCode: '',\n        path: '',\n        component: '',\n        icon: '',\n        menuType: 2,\n        sort: 0,\n        permission: '',\n        status: 1\n      },\n      menuRules: {\n        menuName: [\n          { required: true, message: '请输入菜单名称', trigger: 'blur' }\n        ]\n      }\n    }\n  },\n  created() {\n    this.loadData()\n  },\n  methods: {\n    async loadData() {\n      try {\n        const res = await getMenuTree()\n        this.menuList = res.data\n        this.menuTreeData = [\n          { id: 0, menuName: '根目录', children: res.data }\n        ]\n      } catch (error) {\n        console.error('加载数据失败:', error)\n        this.$message.error('加载数据失败')\n      }\n    },\n    handleAdd(parentId) {\n      this.dialogTitle = parentId === 0 ? '新增菜单' : '添加子菜单'\n      this.menuForm = {\n        id: null,\n        parentId: parentId,\n        menuName: '',\n        menuCode: '',\n        path: '',\n        component: '',\n        icon: '',\n        menuType: parentId === 0 ? 1 : 2,\n        sort: 0,\n        permission: '',\n        status: 1\n      }\n      this.dialogVisible = true\n    },\n    handleEdit(row) {\n      this.dialogTitle = '编辑菜单'\n      this.menuForm = { ...row }\n      this.dialogVisible = true\n    },\n    async handleDelete(row) {\n      try {\n        await this.$confirm('确定要删除这个菜单吗？', '提示', {\n          type: 'warning'\n        })\n        await deleteMenu(row.id)\n        this.$message.success('删除成功')\n        this.loadData()\n      } catch (error) {\n        if (error !== 'cancel') {\n          console.error('删除失败:', error)\n          this.$message.error('删除失败')\n        }\n      }\n    },\n    async handleSubmit() {\n      this.$refs.menuFormRef.validate(async (valid) => {\n        if (valid) {\n          try {\n            if (this.menuForm.id) {\n              await updateMenu(this.menuForm)\n              this.$message.success('更新成功')\n            } else {\n              await createMenu(this.menuForm)\n              this.$message.success('创建成功')\n            }\n            this.dialogVisible = false\n            this.loadData()\n          } catch (error) {\n            console.error('提交失败:', error)\n            this.$message.error('提交失败')\n          }\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.menu-list-container {\n  padding: 0;\n}\n.header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n</style>\n"],"mappings":"AAuGA,SAAAA,WAAA,EAAAC,UAAA,EAAAC,UAAA,EAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,YAAA;MACAC,aAAA;MACAC,WAAA;MACAC,QAAA;QACAC,EAAA;QACAC,QAAA;QACAC,QAAA;QACAC,QAAA;QACAC,IAAA;QACAC,SAAA;QACAC,IAAA;QACAC,QAAA;QACAC,IAAA;QACAC,UAAA;QACAC,MAAA;MACA;MACAC,SAAA;QACAT,QAAA,GACA;UAAAU,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,QAAA;EACA;EACAC,OAAA;IACA,MAAAD,SAAA;MACA;QACA,MAAAE,GAAA,SAAA7B,WAAA;QACA,KAAAM,QAAA,GAAAuB,GAAA,CAAAxB,IAAA;QACA,KAAAE,YAAA,IACA;UAAAI,EAAA;UAAAE,QAAA;UAAAiB,QAAA,EAAAD,GAAA,CAAAxB;QAAA,EACA;MACA,SAAA0B,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;QACA,KAAAE,QAAA,CAAAF,KAAA;MACA;IACA;IACAG,UAAAtB,QAAA;MACA,KAAAH,WAAA,GAAAG,QAAA;MACA,KAAAF,QAAA;QACAC,EAAA;QACAC,QAAA,EAAAA,Q