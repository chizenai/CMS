{"ast":null,"code":"import { getMaterialAll, deleteMaterial } from '@/api/material';\nexport default {\n  name: 'MaterialList',\n  data() {\n    return {\n      materialList: [],\n      viewDialogVisible: false,\n      currentMaterial: {}\n    };\n  },\n  created() {\n    this.loadData();\n  },\n  methods: {\n    async loadData() {\n      try {\n        const res = await getMaterialAll();\n        this.materialList = res.data;\n      } catch (error) {\n        console.error('加载数据失败:', error);\n      }\n    },\n    formatSize(size) {\n      if (!size) return '-';\n      if (size < 1024) {\n        return size + ' B';\n      } else if (size < 1024 * 1024) {\n        return (size / 1024).toFixed(2) + ' KB';\n      } else {\n        return (size / (1024 * 1024)).toFixed(2) + ' MB';\n      }\n    },\n    handleView(row) {\n      this.currentMaterial = {\n        ...row\n      };\n      this.viewDialogVisible = true;\n    },\n    handleDelete(row) {\n      this.$confirm('确定要删除这个素材吗？', '提示', {\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await deleteMaterial(row.id);\n          this.$message.success('删除成功');\n          this.loadData();\n        } catch (error) {\n          console.error('删除失败:', error);\n          this.$message.error('删除失败');\n        }\n      }).catch(() => {});\n    }\n  }\n};","map":{"version":3,"names":["getMaterialAll","deleteMaterial","name","data","materialList","viewDialogVisible","currentMaterial","created","loadData","methods","res","error","console","formatSize","size","toFixed","handleView","row","handleDelete","$confirm","type","then","id","$message","success","catch"],"sources":["src/views/material/MaterialList.vue"],"sourcesContent":["<template>\r\n  <div class=\"material-list-container\">\r\n    <div class=\"card-box\">\r\n      <h3>素材管理</h3>\r\n      <el-table :data=\"materialList\" border>\r\n        <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"文件名称\" min-width=\"200\"></el-table-column>\r\n        <el-table-column prop=\"type\" label=\"类型\" width=\"100\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tag v-if=\"scope.row.type === 'image'\" type=\"success\">图片</el-tag>\r\n            <el-tag v-else-if=\"scope.row.type === 'video'\" type=\"primary\">视频</el-tag>\r\n            <el-tag v-else-if=\"scope.row.type === 'audio'\" type=\"warning\">音频</el-tag>\r\n            <el-tag v-else type=\"info\">文件</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"categoryName\" label=\"栏目\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            {{ scope.row.categoryName || '-' }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"size\" label=\"大小\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatSize(scope.row.size) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"url\" label=\"预览\" width=\"150\">\r\n          <template slot-scope=\"scope\">\r\n            <el-image\r\n              v-if=\"scope.row.type === 'image'\"\r\n              :src=\"scope.row.url\"\r\n              style=\"width: 60px; height: 60px;\"\r\n              fit=\"cover\"\r\n              :preview-src-list=\"[scope.row.url]\"\r\n            ></el-image>\r\n            <span v-else>{{ scope.row.type }}</span>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"180\"></el-table-column>\r\n        <el-table-column label=\"操作\" width=\"150\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button type=\"text\" @click=\"handleView(scope.row)\">查看</el-button>\r\n            <el-button type=\"text\" @click=\"handleDelete(scope.row)\">删除</el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n      <el-empty v-if=\"materialList.length === 0\" description=\"暂无素材\"></el-empty>\r\n    </div>\r\n\r\n    <el-dialog title=\"查看素材\" :visible.sync=\"viewDialogVisible\" width=\"600px\">\r\n      <el-descriptions :column=\"2\" border>\r\n        <el-descriptions-item label=\"ID\">{{ currentMaterial.id }}</el-descriptions-item>\r\n        <el-descriptions-item label=\"文件名称\">{{ currentMaterial.name }}</el-descriptions-item>\r\n        <el-descriptions-item label=\"类型\">\r\n          <el-tag v-if=\"currentMaterial.type === 'image'\" type=\"success\">图片</el-tag>\r\n          <el-tag v-else-if=\"currentMaterial.type === 'video'\" type=\"primary\">视频</el-tag>\r\n          <el-tag v-else-if=\"currentMaterial.type === 'audio'\" type=\"warning\">音频</el-tag>\r\n          <el-tag v-else type=\"info\">文件</el-tag>\r\n        </el-descriptions-item>\r\n        <el-descriptions-item label=\"栏目\">{{ currentMaterial.categoryName || '-' }}</el-descriptions-item>\r\n        <el-descriptions-item label=\"大小\">{{ formatSize(currentMaterial.size) }}</el-descriptions-item>\r\n        <el-descriptions-item label=\"创建时间\">{{ currentMaterial.createTime }}</el-descriptions-item>\r\n      </el-descriptions>\r\n      <div v-if=\"currentMaterial.type === 'image' && currentMaterial.url\" style=\"margin-top: 20px;\">\r\n        <label>预览：</label>\r\n        <el-image\r\n          :src=\"currentMaterial.url\"\r\n          style=\"max-width: 100%; max-height: 400px; margin-top: 10px;\"\r\n          fit=\"contain\"\r\n          :preview-src-list=\"[currentMaterial.url]\"\r\n        ></el-image>\r\n      </div>\r\n      <div v-if=\"currentMaterial.url\" style=\"margin-top: 20px;\">\r\n        <label>访问地址：</label>\r\n        <el-input :value=\"currentMaterial.url\" readonly style=\"margin-top: 10px;\"></el-input>\r\n      </div>\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"viewDialogVisible = false\">关闭</el-button>\r\n      </span>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMaterialAll, deleteMaterial } from '@/api/material'\r\n\r\nexport default {\r\n  name: 'MaterialList',\r\n  data() {\r\n    return {\r\n      materialList: [],\r\n      viewDialogVisible: false,\r\n      currentMaterial: {}\r\n    }\r\n  },\r\n  created() {\r\n    this.loadData()\r\n  },\r\n  methods: {\r\n    async loadData() {\r\n      try {\r\n        const res = await getMaterialAll()\r\n        this.materialList = res.data\r\n      } catch (error) {\r\n        console.error('加载数据失败:', error)\r\n      }\r\n    },\r\n    formatSize(size) {\r\n      if (!size) return '-'\r\n      if (size < 1024) {\r\n        return size + ' B'\r\n      } else if (size < 1024 * 1024) {\r\n        return (size / 1024).toFixed(2) + ' KB'\r\n      } else {\r\n        return (size / (1024 * 1024)).toFixed(2) + ' MB'\r\n      }\r\n    },\r\n    handleView(row) {\r\n      this.currentMaterial = { ...row }\r\n      this.viewDialogVisible = true\r\n    },\r\n    handleDelete(row) {\r\n      this.$confirm('确定要删除这个素材吗？', '提示', {\r\n        type: 'warning'\r\n      }).then(async () => {\r\n        try {\r\n          await deleteMaterial(row.id)\r\n          this.$message.success('删除成功')\r\n          this.loadData()\r\n        } catch (error) {\r\n          console.error('删除失败:', error)\r\n          this.$message.error('删除失败')\r\n        }\r\n      }).catch(() => {})\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.material-list-container {\r\n  padding: 0;\r\n}\r\n</style>\r\n"],"mappings":"AAmFA,SAAAA,cAAA,EAAAC,cAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,iBAAA;MACAC,eAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,QAAA;EACA;EACAC,OAAA;IACA,MAAAD,SAAA;MACA;QACA,MAAAE,GAAA,SAAAV,cAAA;QACA,KAAAI,YAAA,GAAAM,GAAA,CAAAP,IAAA;MACA,SAAAQ,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACAE,WAAAC,IAAA;MACA,KAAAA,IAAA;MACA,IAAAA,IAAA;QACA,OAAAA,IAAA;MACA,WAAAA,IAAA;QACA,QAAAA,IAAA,SAAAC,OAAA;MACA;QACA,QAAAD,IAAA,kBAAAC,OAAA;MACA;IACA;IACAC,WAAAC,GAAA;MACA,KAAAX,eAAA;QAAA,GAAAW;MAAA;MACA,KAAAZ,iBAAA;IACA;IACAa,aAAAD,GAAA;MACA,KAAAE,QAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACA;UACA,MAAApB,cAAA,CAAAgB,GAAA,CAAAK,EAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAhB,QAAA;QACA,SAAAG,KAAA;UACAC,OAAA,CAAAD,KAAA,UAAAA,KAAA;UACA,KAAAY,QAAA,CAAAZ,KAAA;QACA;MACA,GAAAc,KAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}