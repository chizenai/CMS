{"ast":null,"code":"import { getLogList, clearLog } from '@/api/log';\nexport default {\n  name: 'LogList',\n  data() {\n    return {\n      searchForm: {\n        module: '',\n        status: ''\n      },\n      tableData: [],\n      pagination: {\n        pageNum: 1,\n        pageSize: 10,\n        total: 0\n      }\n    };\n  },\n  created() {\n    this.loadData();\n  },\n  methods: {\n    async loadData() {\n      try {\n        const params = {\n          pageNum: this.pagination.pageNum,\n          pageSize: this.pagination.pageSize,\n          ...this.searchForm\n        };\n        Object.keys(params).forEach(key => {\n          if (params[key] === '' || params[key] === null) {\n            delete params[key];\n          }\n        });\n        const res = await getLogList(params);\n        this.tableData = res.data.records;\n        this.pagination.total = res.data.total;\n      } catch (error) {\n        console.error('加载数据失败:', error);\n      }\n    },\n    handleSearch() {\n      this.pagination.pageNum = 1;\n      this.loadData();\n    },\n    handleReset() {\n      this.searchForm = {\n        module: '',\n        status: ''\n      };\n      this.pagination.pageNum = 1;\n      this.loadData();\n    },\n    handleSizeChange(val) {\n      this.pagination.pageSize = val;\n      this.loadData();\n    },\n    handleCurrentChange(val) {\n      this.pagination.pageNum = val;\n      this.loadData();\n    },\n    handleView(row) {\n      this.$alert(`参数: ${row.params}\\n错误信息: ${row.errorMsg || '无'}`, '日志详情', {\n        confirmButtonText: '确定'\n      });\n    },\n    handleClear() {\n      this.$confirm('确定要清空所有日志吗？', '提示', {\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await clearLog();\n          this.$message.success('清空成功');\n          this.loadData();\n        } catch (error) {\n          console.error('清空失败:', error);\n        }\n      }).catch(() => {});\n    }\n  }\n};","map":{"version":3,"names":["getLogList","clearLog","name","data","searchForm","module","status","tableData","pagination","pageNum","pageSize","total","created","loadData","methods","params","Object","keys","forEach","key","res","records","error","console","handleSearch","handleReset","handleSizeChange","val","handleCurrentChange","handleView","row","$alert","errorMsg","confirmButtonText","handleClear","$confirm","type","then","$message","success","catch"],"sources":["src/views/system/LogList.vue"],"sourcesContent":["<template>\r\n  <div class=\"log-list-container\">\r\n    <div class=\"search-box\">\r\n      <el-form :inline=\"true\" :model=\"searchForm\">\r\n        <el-form-item label=\"模块\">\r\n          <el-input v-model=\"searchForm.module\" placeholder=\"请输入模块名\" clearable></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"状态\">\r\n          <el-select v-model=\"searchForm.status\" placeholder=\"请选择状态\" clearable>\r\n            <el-option label=\"成功\" :value=\"1\"></el-option>\r\n            <el-option label=\"失败\" :value=\"0\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" @click=\"handleSearch\">搜索</el-button>\r\n          <el-button @click=\"handleReset\">重置</el-button>\r\n          <el-button type=\"danger\" @click=\"handleClear\">清空日志</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n    </div>\r\n\r\n    <el-table :data=\"tableData\" border>\r\n      <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\r\n      <el-table-column prop=\"module\" label=\"模块\"></el-table-column>\r\n      <el-table-column prop=\"operation\" label=\"操作\"></el-table-column>\r\n      <el-table-column prop=\"method\" label=\"方法\" show-overflow-tooltip></el-table-column>\r\n      <el-table-column prop=\"username\" label=\"操作用户\"></el-table-column>\r\n      <el-table-column prop=\"ip\" label=\"IP地址\"></el-table-column>\r\n      <el-table-column label=\"状态\" width=\"100\">\r\n        <template slot-scope=\"scope\">\r\n          <el-tag :type=\"scope.row.status === 1 ? 'success' : 'danger'\">\r\n            {{ scope.row.status === 1 ? '成功' : '失败' }}\r\n          </el-tag>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"180\"></el-table-column>\r\n      <el-table-column label=\"操作\" width=\"150\">\r\n        <template slot-scope=\"scope\">\r\n          <el-button type=\"text\" @click=\"handleView(scope.row)\">查看详情</el-button>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table>\r\n\r\n    <el-pagination\r\n      class=\"pagination\"\r\n      background\r\n      @size-change=\"handleSizeChange\"\r\n      @current-change=\"handleCurrentChange\"\r\n      :current-page=\"pagination.pageNum\"\r\n      :page-sizes=\"[10, 20, 50, 100]\"\r\n      :page-size=\"pagination.pageSize\"\r\n      layout=\"total, sizes, prev, pager, next, jumper\"\r\n      :total=\"pagination.total\"\r\n    >\r\n    </el-pagination>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getLogList, clearLog } from '@/api/log'\r\n\r\nexport default {\r\n  name: 'LogList',\r\n  data() {\r\n    return {\r\n      searchForm: {\r\n        module: '',\r\n        status: ''\r\n      },\r\n      tableData: [],\r\n      pagination: {\r\n        pageNum: 1,\r\n        pageSize: 10,\r\n        total: 0\r\n      }\r\n    }\r\n  },\r\n  created() {\r\n    this.loadData()\r\n  },\r\n  methods: {\r\n    async loadData() {\r\n      try {\r\n        const params = {\r\n          pageNum: this.pagination.pageNum,\r\n          pageSize: this.pagination.pageSize,\r\n          ...this.searchForm\r\n        }\r\n        Object.keys(params).forEach(key => {\r\n          if (params[key] === '' || params[key] === null) {\r\n            delete params[key]\r\n          }\r\n        })\r\n        const res = await getLogList(params)\r\n        this.tableData = res.data.records\r\n        this.pagination.total = res.data.total\r\n      } catch (error) {\r\n        console.error('加载数据失败:', error)\r\n      }\r\n    },\r\n    handleSearch() {\r\n      this.pagination.pageNum = 1\r\n      this.loadData()\r\n    },\r\n    handleReset() {\r\n      this.searchForm = {\r\n        module: '',\r\n        status: ''\r\n      }\r\n      this.pagination.pageNum = 1\r\n      this.loadData()\r\n    },\r\n    handleSizeChange(val) {\r\n      this.pagination.pageSize = val\r\n      this.loadData()\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.pagination.pageNum = val\r\n      this.loadData()\r\n    },\r\n    handleView(row) {\r\n      this.$alert(`参数: ${row.params}\\n错误信息: ${row.errorMsg || '无'}`, '日志详情', {\r\n        confirmButtonText: '确定'\r\n      })\r\n    },\r\n    handleClear() {\r\n      this.$confirm('确定要清空所有日志吗？', '提示', {\r\n        type: 'warning'\r\n      }).then(async () => {\r\n        try {\r\n          await clearLog()\r\n          this.$message.success('清空成功')\r\n          this.loadData()\r\n        } catch (error) {\r\n          console.error('清空失败:', error)\r\n        }\r\n      }).catch(() => {})\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.log-list-container {\r\n  padding: 0;\r\n}\r\n\r\n.search-box {\r\n  background: #fff;\r\n  padding: 20px;\r\n  border-radius: 4px;\r\n  margin-bottom: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AA2DA,SAAAA,UAAA,EAAAC,QAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;QACAC,MAAA;QACAC,MAAA;MACA;MACAC,SAAA;MACAC,UAAA;QACAC,OAAA;QACAC,QAAA;QACAC,KAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,QAAA;EACA;EACAC,OAAA;IACA,MAAAD,SAAA;MACA;QACA,MAAAE,MAAA;UACAN,OAAA,OAAAD,UAAA,CAAAC,OAAA;UACAC,QAAA,OAAAF,UAAA,CAAAE,QAAA;UACA,QAAAN;QACA;QACAY,MAAA,CAAAC,IAAA,CAAAF,MAAA,EAAAG,OAAA,CAAAC,GAAA;UACA,IAAAJ,MAAA,CAAAI,GAAA,YAAAJ,MAAA,CAAAI,GAAA;YACA,OAAAJ,MAAA,CAAAI,GAAA;UACA;QACA;QACA,MAAAC,GAAA,SAAApB,UAAA,CAAAe,MAAA;QACA,KAAAR,SAAA,GAAAa,GAAA,CAAAjB,IAAA,CAAAkB,OAAA;QACA,KAAAb,UAAA,CAAAG,KAAA,GAAAS,GAAA,CAAAjB,IAAA,CAAAQ,KAAA;MACA,SAAAW,KAAA;QACAC