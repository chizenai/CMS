{"ast":null,"code":"import { getProfile, updateProfile, updatePassword } from '@/api/profile';\nexport default {\n  name: 'Profile',\n  data() {\n    const validateConfirmPassword = (rule, value, callback) => {\n      if (value !== this.passwordForm.newPassword) {\n        callback(new Error('两次输入的密码不一致'));\n      } else {\n        callback();\n      }\n    };\n    return {\n      uploadUrl: '/api/material/upload',\n      profileForm: {\n        id: null,\n        username: '',\n        nickname: '',\n        email: '',\n        phone: '',\n        avatar: ''\n      },\n      passwordForm: {\n        oldPassword: '',\n        newPassword: '',\n        confirmPassword: ''\n      },\n      rules: {\n        nickname: [{\n          required: true,\n          message: '请输入昵称',\n          trigger: 'blur'\n        }],\n        email: [{\n          type: 'email',\n          message: '请输入正确的邮箱地址',\n          trigger: 'blur'\n        }]\n      },\n      passwordRules: {\n        oldPassword: [{\n          required: true,\n          message: '请输入原密码',\n          trigger: 'blur'\n        }],\n        newPassword: [{\n          required: true,\n          message: '请输入新密码',\n          trigger: 'blur'\n        }, {\n          min: 6,\n          message: '密码长度不能少于6位',\n          trigger: 'blur'\n        }],\n        confirmPassword: [{\n          required: true,\n          message: '请再次输入新密码',\n          trigger: 'blur'\n        }, {\n          validator: validateConfirmPassword,\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  created() {\n    this.loadProfile();\n  },\n  methods: {\n    async loadProfile() {\n      try {\n        const res = await getProfile();\n        this.profileForm = {\n          ...res.data\n        };\n      } catch (error) {\n        console.error('加载个人信息失败:', error);\n      }\n    },\n    handleAvatarSuccess(res) {\n      if (res.code === 200) {\n        this.profileForm.avatar = res.data.url;\n      } else {\n        this.$message.error(res.message || '上传失败');\n      }\n    },\n    beforeAvatarUpload(file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png';\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isJPG) {\n        this.$message.error('上传头像图片只能是 JPG 或 PNG 格式!');\n      }\n      if (!isLt2M) {\n        this.$message.error('上传头像图片大小不能超过 2MB!');\n      }\n      return isJPG && isLt2M;\n    },\n    async handleSaveProfile() {\n      this.$refs.profileForm.validate(async valid => {\n        if (valid) {\n          try {\n            await updateProfile(this.profileForm);\n            this.$message.success('修改成功');\n            this.loadProfile();\n          } catch (error) {\n            console.error('修改失败:', error);\n          }\n        }\n      });\n    },\n    async handleChangePassword() {\n      this.$refs.passwordForm.validate(async valid => {\n        if (valid) {\n          try {\n            await updatePassword(this.passwordForm.oldPassword, this.passwordForm.newPassword);\n            this.$message.success('密码修改成功');\n            this.passwordForm = {\n              oldPassword: '',\n              newPassword: '',\n              confirmPassword: ''\n            };\n          } catch (error) {\n            console.error('密码修改失败:', error);\n          }\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["getProfile","updateProfile","updatePassword","name","data","validateConfirmPassword","rule","value","callback","passwordForm","newPassword","Error","uploadUrl","profileForm","id","username","nickname","email","phone","avatar","oldPassword","confirmPassword","rules","required","message","trigger","type","passwordRules","min","validator","created","loadProfile","methods","res","error","console","handleAvatarSuccess","code","url","$message","beforeAvatarUpload","file","isJPG","isLt2M","size","handleSaveProfile","$refs","validate","valid","success","handleChangePassword"],"sources":["src/views/profile/Profile.vue"],"sourcesContent":["<template>\n  <div class=\"profile-container\">\n    <el-card>\n      <div slot=\"header\" class=\"clearfix\">\n        <span>个人信息</span>\n      </div>\n      <el-form :model=\"profileForm\" :rules=\"rules\" ref=\"profileForm\" label-width=\"100px\" class=\"profile-form\">\n        <el-form-item label=\"用户名\">\n          <el-input v-model=\"profileForm.username\" disabled></el-input>\n        </el-form-item>\n        <el-form-item label=\"昵称\" prop=\"nickname\">\n          <el-input v-model=\"profileForm.nickname\" placeholder=\"请输入昵称\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"邮箱\" prop=\"email\">\n          <el-input v-model=\"profileForm.email\" placeholder=\"请输入邮箱\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"手机号\" prop=\"phone\">\n          <el-input v-model=\"profileForm.phone\" placeholder=\"请输入手机号\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"头像\">\n          <el-upload\n            class=\"avatar-uploader\"\n            :action=\"uploadUrl\"\n            :show-file-list=\"false\"\n            :on-success=\"handleAvatarSuccess\"\n            :before-upload=\"beforeAvatarUpload\">\n            <img v-if=\"profileForm.avatar\" :src=\"profileForm.avatar\" class=\"avatar\">\n            <i v-else class=\"el-icon-plus avatar-uploader-icon\"></i>\n          </el-upload>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" @click=\"handleSaveProfile\">保存修改</el-button>\n        </el-form-item>\n      </el-form>\n    </el-card>\n\n    <el-card style=\"margin-top: 20px;\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span>修改密码</span>\n      </div>\n      <el-form :model=\"passwordForm\" :rules=\"passwordRules\" ref=\"passwordForm\" label-width=\"100px\" class=\"password-form\">\n        <el-form-item label=\"原密码\" prop=\"oldPassword\">\n          <el-input v-model=\"passwordForm.oldPassword\" type=\"password\" placeholder=\"请输入原密码\" show-password></el-input>\n        </el-form-item>\n        <el-form-item label=\"新密码\" prop=\"newPassword\">\n          <el-input v-model=\"passwordForm.newPassword\" type=\"password\" placeholder=\"请输入新密码\" show-password></el-input>\n        </el-form-item>\n        <el-form-item label=\"确认密码\" prop=\"confirmPassword\">\n          <el-input v-model=\"passwordForm.confirmPassword\" type=\"password\" placeholder=\"请再次输入新密码\" show-password></el-input>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" @click=\"handleChangePassword\">修改密码</el-button>\n        </el-form-item>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { getProfile, updateProfile, updatePassword } from '@/api/profile'\n\nexport default {\n  name: 'Profile',\n  data() {\n    const validateConfirmPassword = (rule, value, callback) => {\n      if (value !== this.passwordForm.newPassword) {\n        callback(new Error('两次输入的密码不一致'))\n      } else {\n        callback()\n      }\n    }\n\n    return {\n      uploadUrl: '/api/material/upload',\n      profileForm: {\n        id: null,\n        username: '',\n        nickname: '',\n        email: '',\n        phone: '',\n        avatar: ''\n      },\n      passwordForm: {\n        oldPassword: '',\n        newPassword: '',\n        confirmPassword: ''\n      },\n      rules: {\n        nickname: [\n          { required: true, message: '请输入昵称', trigger: 'blur' }\n        ],\n        email: [\n          { type: 'email', message: '请输入正确的邮箱地址', trigger: 'blur' }\n        ]\n      },\n      passwordRules: {\n        oldPassword: [\n          { required: true, message: '请输入原密码', trigger: 'blur' }\n        ],\n        newPassword: [\n          { required: true, message: '请输入新密码', trigger: 'blur' },\n          { min: 6, message: '密码长度不能少于6位', trigger: 'blur' }\n        ],\n        confirmPassword: [\n          { required: true, message: '请再次输入新密码', trigger: 'blur' },\n          { validator: validateConfirmPassword, trigger: 'blur' }\n        ]\n      }\n    }\n  },\n  created() {\n    this.loadProfile()\n  },\n  methods: {\n    async loadProfile() {\n      try {\n        const res = await getProfile()\n        this.profileForm = { ...res.data }\n      } catch (error) {\n        console.error('加载个人信息失败:', error)\n      }\n    },\n    handleAvatarSuccess(res) {\n      if (res.code === 200) {\n        this.profileForm.avatar = res.data.url\n      } else {\n        this.$message.error(res.message || '上传失败')\n      }\n    },\n    beforeAvatarUpload(file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png'\n      const isLt2M = file.size / 1024 / 1024 < 2\n\n      if (!isJPG) {\n        this.$message.error('上传头像图片只能是 JPG 或 PNG 格式!')\n      }\n      if (!isLt2M) {\n        this.$message.error('上传头像图片大小不能超过 2MB!')\n      }\n      return isJPG && isLt2M\n    },\n    async handleSaveProfile() {\n      this.$refs.profileForm.validate(async (valid) => {\n        if (valid) {\n          try {\n            await updateProfile(this.profileForm)\n            this.$message.success('修改成功')\n            this.loadProfile()\n          } catch (error) {\n            console.error('修改失败:', error)\n          }\n        }\n      })\n    },\n    async handleChangePassword() {\n      this.$refs.passwordForm.validate(async (valid) => {\n        if (valid) {\n          try {\n            await updatePassword(this.passwordForm.oldPassword, this.passwordForm.newPassword)\n            this.$message.success('密码修改成功')\n            this.passwordForm = {\n              oldPassword: '',\n              newPassword: '',\n              confirmPassword: ''\n            }\n          } catch (error) {\n            console.error('密码修改失败:', error)\n          }\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.profile-container {\n  padding: 0;\n}\n\n.profile-form,\n.password-form {\n  max-width: 500px;\n}\n\n.avatar-uploader {\n  text-align: center;\n}\n\n.avatar-uploader >>> .el-upload {\n  border: 1px dashed #d9d9d9;\n  border-radius: 6px;\n  cursor: pointer;\n  position: relative;\n  overflow: hidden;\n}\n\n.avatar-uploader >>> .el-upload:hover {\n  border-color: #409eff;\n}\n\n.avatar-uploader-icon {\n  font-size: 28px;\n  color: #8c939d;\n  width: 148px;\n  height: 148px;\n  line-height: 148px;\n  text-align: center;\n}\n\n.avatar {\n  width: 148px;\n  height: 148px;\n  display: block;\n  object-fit: cover;\n}\n</style>\n"],"mappings":"AA2DA,SAAAA,UAAA,EAAAC,aAAA,EAAAC,cAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA,MAAAC,uBAAA,GAAAA,CAAAC,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,IAAAD,KAAA,UAAAE,YAAA,CAAAC,WAAA;QACAF,QAAA,KAAAG,KAAA;MACA;QACAH,QAAA;MACA;IACA;IAEA;MACAI,SAAA;MACAC,WAAA;QACAC,EAAA;QACAC,QAAA;QACAC,QAAA;QACAC,KAAA;QACAC,KAAA;QACAC,MAAA;MACA;MACAV,YAAA;QACAW,WAAA;QACAV,WAAA;QACAW,eAAA;MACA;MACAC,KAAA;QACAN,QAAA,GACA;UAAAO,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAR,KAAA,GACA;UAAAS,IAAA;UAAAF,OAAA;UAAAC,OAAA;QAAA;MAEA;MACAE,aAAA;QACAP,WAAA,GACA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAf,WAAA,GACA;UAAAa,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAG,GAAA;UAAAJ,OAAA;UAAAC,OAAA;QAAA,EACA;QACAJ,eAAA,GACA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAI,SAAA,EAAAxB,uBAAA;UAAAoB,OAAA;QAAA;MAEA;IACA;EACA;EACAK,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACA,MAAAD,YAAA;MACA;QACA,MAAAE,GAAA,SAAAjC,UAAA;QACA,KAAAa,WAAA;UAAA,GAAAoB,GAAA,CAAA7B;QAAA;MACA,SAAA8B,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACAE,oBAAAH,GAAA;MACA,IAAAA,GAAA,CAAAI,IAAA;QACA,KAAAxB,WAAA,CAAAM,MAAA,GAAAc,GAAA,CAAA7B,IAAA,CAAAkC,GAAA;MACA;QACA,KAAAC,QAAA,CAAAL,KAAA,CAAAD,GAAA,CAAAT,OAAA;MACA;IACA;IACAgB,mBAAAC,IAAA;MACA,MAAAC,KAAA,GAAAD,IAAA,CAAAf,IAAA,qBAAAe,IAAA,CAAAf,IAAA;MACA,MAAAiB,MAAA,GAAAF,IAAA,CAAAG,IAAA;MAEA,KAAAF,KAAA;QACA,KAAAH,QAAA,CAAAL,KAAA;MACA;MACA,KAAAS,MAAA;QACA,KAAAJ,QAAA,CAAAL,KAAA;MACA;MACA,OAAAQ,KAAA,IAAAC,MAAA;IACA;IACA,MAAAE,kBAAA;MACA,KAAAC,KAAA,CAAAjC,WAAA,CAAAkC,QAAA,OAAAC,KAAA;QACA,IAAAA,KAAA;UACA;YACA,MAAA/C,aAAA,MAAAY,WAAA;YACA,KAAA0B,QAAA,CA