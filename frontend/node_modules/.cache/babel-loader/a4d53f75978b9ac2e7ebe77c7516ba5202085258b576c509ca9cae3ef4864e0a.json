{"ast":null,"code":"import { getUserList, deleteUser, resetPassword } from '@/api/user';\nexport default {\n  name: 'UserList',\n  data() {\n    return {\n      searchForm: {\n        username: '',\n        status: ''\n      },\n      tableData: [],\n      pagination: {\n        pageNum: 1,\n        pageSize: 10,\n        total: 0\n      }\n    };\n  },\n  created() {\n    this.loadData();\n  },\n  methods: {\n    async loadData() {\n      try {\n        const params = {\n          pageNum: this.pagination.pageNum,\n          pageSize: this.pagination.pageSize,\n          ...this.searchForm\n        };\n        Object.keys(params).forEach(key => {\n          if (params[key] === '' || params[key] === null) {\n            delete params[key];\n          }\n        });\n        const res = await getUserList(params);\n        this.tableData = res.data.records;\n        this.pagination.total = res.data.total;\n      } catch (error) {\n        console.error('加载数据失败:', error);\n      }\n    },\n    handleSearch() {\n      this.pagination.pageNum = 1;\n      this.loadData();\n    },\n    handleReset() {\n      this.searchForm = {\n        username: '',\n        status: ''\n      };\n      this.pagination.pageNum = 1;\n      this.loadData();\n    },\n    handleSizeChange(val) {\n      this.pagination.pageSize = val;\n      this.loadData();\n    },\n    handleCurrentChange(val) {\n      this.pagination.pageNum = val;\n      this.loadData();\n    },\n    handleAdd() {\n      this.$message.info('新增用户功能开发中');\n    },\n    handleEdit(row) {\n      this.$message.info('编辑功能开发中');\n    },\n    handleResetPwd(row) {\n      this.$prompt('请输入新密码', '重置密码', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        inputType: 'password'\n      }).then(async ({\n        value\n      }) => {\n        try {\n          await resetPassword(row.id, value);\n          this.$message.success('密码重置成功');\n        } catch (error) {\n          console.error('重置密码失败:', error);\n        }\n      }).catch(() => {});\n    },\n    handleDelete(row) {\n      this.$confirm('确定要删除这个用户吗？', '提示', {\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await deleteUser(row.id);\n          this.$message.success('删除成功');\n          this.loadData();\n        } catch (error) {\n          console.error('删除失败:', error);\n        }\n      }).catch(() => {});\n    }\n  }\n};","map":{"version":3,"names":["getUserList","deleteUser","resetPassword","name","data","searchForm","username","status","tableData","pagination","pageNum","pageSize","total","created","loadData","methods","params","Object","keys","forEach","key","res","records","error","console","handleSearch","handleReset","handleSizeChange","val","handleCurrentChange","handleAdd","$message","info","handleEdit","row","handleResetPwd","$prompt","confirmButtonText","cancelButtonText","inputType","then","value","id","success","catch","handleDelete","$confirm","type"],"sources":["src/views/system/UserList.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-list-container\">\r\n    <div class=\"search-box\">\r\n      <el-form :inline=\"true\" :model=\"searchForm\">\r\n        <el-form-item label=\"用户名\">\r\n          <el-input v-model=\"searchForm.username\" placeholder=\"请输入用户名\" clearable></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"状态\">\r\n          <el-select v-model=\"searchForm.status\" placeholder=\"请选择状态\" clearable>\r\n            <el-option label=\"启用\" :value=\"1\"></el-option>\r\n            <el-option label=\"禁用\" :value=\"0\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" @click=\"handleSearch\">搜索</el-button>\r\n          <el-button @click=\"handleReset\">重置</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n    </div>\r\n\r\n    <div class=\"toolbar\">\r\n      <el-button type=\"primary\" @click=\"handleAdd\">新增用户</el-button>\r\n    </div>\r\n\r\n    <el-table :data=\"tableData\" border>\r\n      <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\r\n      <el-table-column prop=\"username\" label=\"用户名\"></el-table-column>\r\n      <el-table-column prop=\"nickname\" label=\"昵称\"></el-table-column>\r\n      <el-table-column prop=\"email\" label=\"邮箱\"></el-table-column>\r\n      <el-table-column prop=\"phone\" label=\"手机号\"></el-table-column>\r\n      <el-table-column label=\"状态\" width=\"100\">\r\n        <template slot-scope=\"scope\">\r\n          <el-tag :type=\"scope.row.status === 1 ? 'success' : 'danger'\">\r\n            {{ scope.row.status === 1 ? '启用' : '禁用' }}\r\n          </el-tag>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"180\"></el-table-column>\r\n      <el-table-column label=\"操作\" width=\"250\">\r\n        <template slot-scope=\"scope\">\r\n          <el-button type=\"text\" @click=\"handleEdit(scope.row)\">编辑</el-button>\r\n          <el-button type=\"text\" @click=\"handleResetPwd(scope.row)\">重置密码</el-button>\r\n          <el-button type=\"text\" @click=\"handleDelete(scope.row)\">删除</el-button>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table>\r\n\r\n    <el-pagination\r\n      class=\"pagination\"\r\n      background\r\n      @size-change=\"handleSizeChange\"\r\n      @current-change=\"handleCurrentChange\"\r\n      :current-page=\"pagination.pageNum\"\r\n      :page-sizes=\"[10, 20, 50, 100]\"\r\n      :page-size=\"pagination.pageSize\"\r\n      layout=\"total, sizes, prev, pager, next, jumper\"\r\n      :total=\"pagination.total\"\r\n    >\r\n    </el-pagination>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getUserList, deleteUser, resetPassword } from '@/api/user'\r\n\r\nexport default {\r\n  name: 'UserList',\r\n  data() {\r\n    return {\r\n      searchForm: {\r\n        username: '',\r\n        status: ''\r\n      },\r\n      tableData: [],\r\n      pagination: {\r\n        pageNum: 1,\r\n        pageSize: 10,\r\n        total: 0\r\n      }\r\n    }\r\n  },\r\n  created() {\r\n    this.loadData()\r\n  },\r\n  methods: {\r\n    async loadData() {\r\n      try {\r\n        const params = {\r\n          pageNum: this.pagination.pageNum,\r\n          pageSize: this.pagination.pageSize,\r\n          ...this.searchForm\r\n        }\r\n        Object.keys(params).forEach(key => {\r\n          if (params[key] === '' || params[key] === null) {\r\n            delete params[key]\r\n          }\r\n        })\r\n        const res = await getUserList(params)\r\n        this.tableData = res.data.records\r\n        this.pagination.total = res.data.total\r\n      } catch (error) {\r\n        console.error('加载数据失败:', error)\r\n      }\r\n    },\r\n    handleSearch() {\r\n      this.pagination.pageNum = 1\r\n      this.loadData()\r\n    },\r\n    handleReset() {\r\n      this.searchForm = {\r\n        username: '',\r\n        status: ''\r\n      }\r\n      this.pagination.pageNum = 1\r\n      this.loadData()\r\n    },\r\n    handleSizeChange(val) {\r\n      this.pagination.pageSize = val\r\n      this.loadData()\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.pagination.pageNum = val\r\n      this.loadData()\r\n    },\r\n    handleAdd() {\r\n      this.$message.info('新增用户功能开发中')\r\n    },\r\n    handleEdit(row) {\r\n      this.$message.info('编辑功能开发中')\r\n    },\r\n    handleResetPwd(row) {\r\n      this.$prompt('请输入新密码', '重置密码', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        inputType: 'password'\r\n      }).then(async ({ value }) => {\r\n        try {\r\n          await resetPassword(row.id, value)\r\n          this.$message.success('密码重置成功')\r\n        } catch (error) {\r\n          console.error('重置密码失败:', error)\r\n        }\r\n      }).catch(() => {})\r\n    },\r\n    handleDelete(row) {\r\n      this.$confirm('确定要删除这个用户吗？', '提示', {\r\n        type: 'warning'\r\n      }).then(async () => {\r\n        try {\r\n          await deleteUser(row.id)\r\n          this.$message.success('删除成功')\r\n          this.loadData()\r\n        } catch (error) {\r\n          console.error('删除失败:', error)\r\n        }\r\n      }).catch(() => {})\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.user-list-container {\r\n  padding: 0;\r\n}\r\n\r\n.search-box {\r\n  background: #fff;\r\n  padding: 20px;\r\n  border-radius: 4px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.toolbar {\r\n  margin-bottom: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AA+DA,SAAAA,WAAA,EAAAC,UAAA,EAAAC,aAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;QACAC,QAAA;QACAC,MAAA;MACA;MACAC,SAAA;MACAC,UAAA;QACAC,OAAA;QACAC,QAAA;QACAC,KAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,QAAA;EACA;EACAC,OAAA;IACA,MAAAD,SAAA;MACA;QACA,MAAAE,MAAA;UACAN,OAAA,OAAAD,UAAA,CAAAC,OAAA;UACAC,QAAA,OAAAF,UAAA,CAAAE,QAAA;UACA,QAAAN;QACA;QACAY,MAAA,CAAAC,IAAA,CAAAF,MAAA,EAAAG,OAAA,CAAAC,GAAA;UACA,IAAAJ,MAAA,CAAAI,GAAA,YAAAJ,MAAA,CAAAI,GAAA;YACA,OAAAJ,MAAA,CAAAI,GAAA;UACA;QACA;QACA,MAAAC,GAAA,SAAArB,WAAA,CAAAgB,MAAA;QACA,KAAAR,SAAA,GAAAa,GAAA,CAAAjB,IAAA,CAAAkB,OAAA;QACA,KAAAb,UAAA,CAAAG,KAAA,GAAAS,GAAA,CAAAjB,IAAA,CAAAQ,KAAA;MACA,SAAAW,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACAE,aAAA;MACA,KAAAhB,UAAA,CAAAC,OAAA;MACA,KAAAI,QAAA;IACA;IACAY,YAAA;MACA,KAAArB,UAAA;QACAC,QAAA;QACAC,MAAA;MACA;MACA,KAAAE,UAAA,CAAAC,OAAA;MACA,KAAAI,QAAA;IACA;IACAa,iBAAAC,GAAA;MACA,KAAAnB,UAAA,CAAAE,QAAA,GAAAiB,GAAA;MACA,KAAAd,QAAA;IACA;IACAe,oBAAAD,GAAA;MACA,KAAAnB,UAAA,CAAAC,OAAA,GAAAkB,GAAA;MACA,KAAAd,QAAA;IACA;IACAgB,UAAA;MACA,KAAAC,QAAA,CAAAC,IAAA;IACA;IACAC,WAAAC,GAAA;MACA,KAAAH,QAAA,CAAAC,IAAA;IACA;IACAG,eAAAD,GAAA;MACA,KAAAE,OAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,SAAA;MACA,GAAAC,IAAA;QAAAC;MAAA;QACA;UACA,MAAAvC,aAAA,CAAAgC,GAAA,CAAAQ,EAAA,EAAAD,KAAA;UACA,KAAAV,QAAA,CAAAY,OAAA;QACA,SAAApB,KAAA;UACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;QACA;MACA,GAAAqB,KAAA;IACA;IACAC,aAAAX,GAAA;MACA,KAAAY,QAAA;QACAC,IAAA;MACA,GAAAP,IAAA;QACA;UACA,MAAAvC,UAAA,